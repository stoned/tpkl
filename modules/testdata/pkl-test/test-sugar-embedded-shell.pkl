amends "pkl:test"

import "tpkl:tpkl"

examples {
  //
  // sugar for running a script with the embedded shell
  //

  ["anonymous-function-with-string"] {
    new tpkl.Task {
      cmds {
        (#"printf '%s\n' "$@""# |> tpkl.sh) {
          cmd { "arg1"; "arg 2" }
        }
      }
    }
  }

  ["anonymous-function-with-list"] {
    new tpkl.Task {
      cmds {
        List(#"printf '%s\n' "$@""#, "arg1", "arg 2") |> tpkl.sh
      }
    }
  }

  ["anonymous-function-with-listing"] {
    new tpkl.Task {
      cmds {
        new Listing { #"printf '%s\n' "$@""#; "arg1"; "arg 2" } |> tpkl.sh
      }
    }
  }

  ["anonymous-function-with-dynamic"] {
    new tpkl.Task {
      cmds {
        new Dynamic { #"printf '%s\n' "$@""#; "-"; "arg1"; "arg 2" } |> tpkl.sh
      }
    }
  }

  ["function-with-string"] {
    new tpkl.Task {
      cmds {
        (tpkl.sh(#"printf '%s\n' "$@""#)) {
          cmd { "arg1"; "arg 2" }
        }
      }
    }
  }

  ["function-with-list"] {
    new tpkl.Task {
      cmds {
        tpkl.sh(List(#"printf '%s\n' "$@""#, "arg1", "arg 2"))
      }
    }
  }

  ["function-with-listing"] {
    new tpkl.Task {
      cmds {
        tpkl.sh(new Listing { #"printf '%s\n' "$@""#; "arg1"; "arg 2" })
      }
    }
  }

  ["function-with-dynamic"] {
    new tpkl.Task {
      cmds {
        tpkl.sh(new Dynamic { #"printf '%s\n' "$@""#; "arg1"; "arg 2" })
      }
    }
  }

  ["amending"] {
    new tpkl.Task {
      cmds {
        (tpkl.Sh) {
          cmd { #"printf '%s\n' "$@""#; "arg1"; "arg 2" }
        }
      }
    }
  }
}
