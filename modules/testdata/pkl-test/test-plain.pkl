amends "pkl:test"

import "tpkl:tpkl"

examples {
  ["default"] {
    new tpkl.Task {
      cmds {
        new {
          cmd { "echo default" }
        }
      }
    }
  }

  ["cmd"] {
    new tpkl.Task {
      cmds {
        new {
          embeddedShell = false
          cmd { "echo"; "cmd" }
        }
      }
    }
  }
}
