amends "pkl:test"

import "tpkl:tpkl"

examples {
  //
  // sugar for running a script with /bin/bash
  //

  ["anonymous-function-with-string"] {
    new tpkl.Task {
      cmds {
        (#"printf '%s\n' "$@""# |> tpkl.bash) {
          cmd { "-"; "arg1"; "arg 2" }
        }
      }
    }
  }

  ["anonymous-function-with-list"] {
    new tpkl.Task {
      cmds {
        List(#"printf '%s\n' "$@""#, "-", "arg1", "arg 2") |> tpkl.bash
      }
    }
  }

  ["anonymous-function-with-listing"] {
    new tpkl.Task {
      cmds {
        new Listing { #"printf '%s\n' "$@""#; "-"; "arg1"; "arg 2" } |> tpkl.bash
      }
    }
  }

  ["anonymous-function-with-dynamic"] {
    new tpkl.Task {
      cmds {
        new Dynamic { #"printf '%s\n' "$@""#; "-"; "arg1"; "arg 2" } |> tpkl.bash
      }
    }
  }

  ["function-with-string"] {
    new tpkl.Task {
      cmds {
        (tpkl.bash(#"printf '%s\n' "$@""#)) {
          cmd { "-"; "arg1"; "arg 2" }
        }
      }
    }
  }

  ["function-with-list"] {
    new tpkl.Task {
      cmds {
        tpkl.bash(List(#"printf '%s\n' "$@""#, "-", "arg1", "arg 2"))
      }
    }
  }

  ["function-with-listing"] {
    new tpkl.Task {
      cmds {
        tpkl.bash(new Listing { #"printf '%s\n' "$@""#; "-"; "arg1"; "arg 2" })
      }
    }
  }

  ["function-with-dynamic"] {
    new tpkl.Task {
      cmds {
        tpkl.bash(new Dynamic { #"printf '%s\n' "$@""#; "-"; "arg1"; "arg 2" })
      }
    }
  }

  ["amending"] {
    new tpkl.Task {
      cmds {
        (tpkl.Bash) {
          cmd { #"printf '%s\n' "$@""#; "-"; "arg1"; "arg 2" }
        }
      }
    }
  }
}
