  ["default"] {
    new {
      cmds {
        new {
          cmd {
            "echo default"
          }
          task = null
          embeddedShell = true
          mustSucceed = true
        }
      }
      doc = null
      env {}
      files {}
      inheritEnv = true
      summary = ""
      workingDir = "."
    }
  }
  ["cmd"] {
    new {
      cmds {
        new {
          cmd {
            "echo"
            "cmd"
          }
          task = null
          embeddedShell = false
          mustSucceed = true
        }
      }
      doc = null
      env {}
      files {}
      inheritEnv = true
      summary = ""
      workingDir = "."
    }
  }
}
