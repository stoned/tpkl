amends "pkl:test"

import "tpkl:tpkl"

examples {
  //
  // sugar for running a command
  //

  ["anonymous-function-with-string"] {
    new tpkl.Task {
      cmds {
        (#"printf %s\n"# |> tpkl.cmd) {
          cmd { "arg1"; "arg 2" }
        }
      }
    }
  }

  ["anonymous-function-with-list"] {
    new tpkl.Task {
      cmds {
        List("printf", "%s\n", "arg1", "arg 2") |> tpkl.cmd
      }
    }
  }

  ["anonymous-function-with-listing"] {
    new tpkl.Task {
      cmds {
        new Listing { "printf"; #"%s\n"#; "arg1"; "arg 2" } |> tpkl.cmd
      }
    }
  }

  ["anonymous-function-with-dynamic"] {
    new tpkl.Task {
      cmds {
        new Dynamic { "printf"; #"%s\n"#; "arg1"; "arg 2" } |> tpkl.cmd
      }
    }
  }

  ["function-with-string"] {
    new tpkl.Task {
      cmds {
        (tpkl.cmd(#"printf %s\n"#)) {
          cmd { "arg1"; "arg 2" }
        }
      }
    }
  }

  ["function-with-list"] {
    new tpkl.Task {
      cmds {
        tpkl.cmd(List("printf", #"%s\n"#, "arg1", "arg 2"))
      }
    }
  }

  ["function-with-listing"] {
    new tpkl.Task {
      cmds {
        tpkl.cmd(new Listing { "printf"; #"%s\n"#; "arg1"; "arg 2" })
      }
    }
  }

  ["function-with-dynamic"] {
    new tpkl.Task {
      cmds {
        tpkl.cmd(new Dynamic { "printf"; #"%s\n"#; "arg1"; "arg 2" })
      }
    }
  }

  ["amending"] {
    new tpkl.Task {
      cmds {
        (tpkl.Cmd) {
          cmd { "printf"; #"%s\n"#; "arg1"; "arg 2" }
        }
      }
    }
  }
}
