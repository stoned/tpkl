amends "pkl:test"

import "tpkl:tpkl"

examples {
  ["none"] {
    new tpkl.Task {}
  }

  ["oneline"] {
    new tpkl.Task {
      doc = "the task t1"
    }
  }

  ["moredoc"] {
    new tpkl.Task {
      doc =
        """
        the task t1

        This tasks does something.
        """
    }
  }

  ["space"] {
    new tpkl.Task {
      doc =
        """

        the task t1

        This tasks does something.
        """
    }
  }

  ["morespace"] {
    new tpkl.Task {
      doc =
        """
        \t
        the task t1

        This tasks does something.
        """
    }
  }

  ["stillmorespace"] {
    new tpkl.Task {
      doc =
        """

         \t 

        \t

        the task t1

        This tasks does something.
        """
    }
  }
}
