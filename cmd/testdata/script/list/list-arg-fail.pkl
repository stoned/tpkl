import "pkl:shell"
import "tpkl:tpkl"

tasks: tpkl.Tasks = new {
  ["val"] {
    local varValue = read("env:\(tpkl.argv[0])")
    cmds {
      "echo \(shell.escapeWithSingleQuotes(varValue))" |> tpkl.sh
    }
  }
  ["valHOME"] {
    local home = read("env:HOME")
    cmds {
      "echo \(home)" |> tpkl.sh
    }
  }
}

