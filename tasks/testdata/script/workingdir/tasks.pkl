// Test workingDir Task property
import "tpkl:tpkl"

tasks: tpkl.Tasks = new {
  ["workingDirDefaultValue"] {
    cmds {
      new {
        cmd { "pwd" }
        embeddedShell = true
      }
    }
  }
  ["subdir"] {
    cmds {
      new {
        cmd { "pwd" }
        embeddedShell = true
      }
    }
    workingDir = "subdir"
  }
}
