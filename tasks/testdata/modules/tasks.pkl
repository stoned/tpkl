import "tpkl:tpkl"

tasks: tpkl.Tasks = new {
  ["nodoc"] {
    cmds {
      new {
        cmd { "echo 'nodoc!'" }
      }
    }
  }

  ["task"] {
    doc =
      """
      The **task** task.
      foo bar
      baz
      """
    cmds {
      new {
        cmd { "echo 'Hello, world!'" }
      }
    }
  }

  ["neon"] {
    doc = "***this*** **is** *the* `neon` task"
    cmds {
      new {
        cmd { "echo neon" }
        embeddedShell = true
      }
    }
    files {
      ["dummy"] {
        content = "foo"
        filename = "dummy.txt"
        varname = "FOO"
      }
    }
  }

  when (read?("prop:cond") != null) {
    ["condTask"] {
      doc =
        """
        Conditional task.
        """
      cmds {
        new {
          cmd { "echo 'conditional!'" }
        }
      }
    }
  }
}
